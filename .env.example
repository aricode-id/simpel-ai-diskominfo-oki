APP_NAME="SIMPEL-AI Diskominfo OKI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (MySQL / MariaDB)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simpel_ai
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# SESSION, QUEUE, & CACHE CONFIGURATION
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ==============================================================================
# GOOGLE GEMINI GENERATIVE AI API CONFIGURATION
# ==============================================================================
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# GOOGLE OAUTH 2.0 & GOOGLE DRIVE API CONFIGURATION
# ==============================================================================
# Kredensial OAuth Client ID dari Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Pastikan 'Authorized redirect URIs' diatur ke: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Email Super Admin (Pisahkan dengan koma jika lebih dari satu)
SUPER_ADMIN_EMAILS="ariirawan022021@gmail.com,ariirawann022021@gmail.com,ari@oki.go.id"

# ==============================================================================
# MAILER CONFIGURATION (OPSIONAL / UNTUK FITUR NOTIFIKASI & RESET PASSWORD)
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@diskominfo.oki.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# FILESYSTEM / STORAGE
# ==============================================================================
FILESYSTEM_DISK=public

VITE_APP_NAME="${APP_NAME}"
